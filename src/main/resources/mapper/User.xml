<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//OTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.back.mapper.UserMapper">
    <select id="getByPhone" resultType="com.example.back.dao.User">
        select * from user where phone= #{phone}
    </select>

    <select id="getByEmail" resultType="com.example.back.dao.User">
        select * from user where email= #{email}
    </select>

    <insert id="save">
        insert into user(phone,password)
        values (#{phone},#{password})
    </insert>

    <update id="update">
        update user
        set password = #{password}
        where phone = #{phone}
    </update>

</mapper>