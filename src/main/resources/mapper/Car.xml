<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//OTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.back.mapper.CarMapper">
    <select id="getByPhone" resultType="com.example.back.dao.Car">
        select * from relationship where phone= #{phone} limit 1
    </select>

</mapper>